# ==============================================================================
# SHIN MOVIE — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. DO NOT commit production .env files containing real passwords or secrets to Git.
# 2. In production, configure these variables directly in your hosting provider's
#    secret manager (e.g., Azure App Service Configuration, AWS Secrets Manager,
#    Docker Compose .env, or Linux environment variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Microsoft SQL Server)
# ------------------------------------------------------------------------------
# Standard SQL Server authentication:
# Server=your-db-host.database.windows.net;Database=MovieStreamingDb;User Id=your_user;Password=your_strong_password;TrustServerCertificate=False;Encrypt=True;
DATABASE_CONNECTION_STRING=Server=your-sql-server-host;Database=MovieStreamingDb;User Id=shin_app_user;Password=ChangeMe_StrongPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=True;

# ------------------------------------------------------------------------------
# 2. JWT AUTHENTICATION (Security)
# ------------------------------------------------------------------------------
# Secret key MUST be at least 32 characters (256-bit) and generated using a secure RNG.
# Generate on Linux/Mac: openssl rand -base64 32
# Generate on PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET_KEY=YOUR_CRYPTOGRAPHICALLY_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARS_LONG!
JWT_ISSUER=MovieStreaming
JWT_AUDIENCE=MovieStreamingClient
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# ------------------------------------------------------------------------------
# 3. CORS & HOSTING ORIGINS
# ------------------------------------------------------------------------------
# Allowed frontend domain(s) permitted to communicate with the API.
FRONTEND_URL=https://shinmovie.com
# Additional origins if needed:
# Cors__AllowedOrigins__1=https://www.shinmovie.com

# ------------------------------------------------------------------------------
# 4. EXTERNAL INTEGRATION
# ------------------------------------------------------------------------------
KKPHIM_BASE_URL=https://phimapi.com
KKPHIM_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT & DIAGNOSTICS
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Set to true only if temporary Swagger inspection is required in production:
EnableSwaggerInProduction=false
